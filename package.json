{
  "name": "report-processing-engine-front",
  "version": "1.0.0",
  "description": "Report Processing Engine Frontend - 智能报告生成引擎前端",
  "author": "SCYY Team",
  "scripts": {
    "start": "vue-cli-service serve --mode mock",
    "dev": "http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= && vue-cli-service serve",
    "dev:local": "vue-cli-service serve --mode local",
    "build": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "build:dev": "vue-cli-service build --mode dev",
    "build:uat": "vue-cli-service build --mode uat",
    "build:test": "vue-cli-service build --mode test",
    "build:stg": "vue-cli-service build --mode stg",
    "build:prod": "vue-cli-service build",
    "preview": "node build/index.js --preview",
    "lint": "eslint --ext .js,.vue src"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "core-js": "^3.21.1",
    "dayjs": "^1.11.1",
    "docx-preview": "^0.1.14",
    "downloadjs": "^1.4.7",
    "element-ui": "^2.15.6",
    "file-saver": "^2.0.5",
    "js-cookie": "3.0.8",
    "jszip": "^3.9.1",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "qiankun": "2.9.3",
    "qs": "^6.14.0",
    "sortablejs": "^1.15.0",
    "vue": "2.6.10",
    "vue-i18n": "7.3.2",
    "vue-json-viewer": "^2.2.22",
    "vue-router": "3.0.6",
    "vuex": "3.1.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.16",
    "@vue/cli-plugin-eslint": "4.5.16",
    "@vue/cli-service": "4.5.16",
    "autoprefixer": "9.5.1",
    "babel-eslint": "10.1.0",
    "babel-plugin-component": "1.1.1",
    "babel-plugin-import": "1.13.5",
    "compression-webpack-plugin": "^1.1.12",
    "element-theme-chalk": "^2.15.6",
    "eslint": "6.7.2",
    "eslint-plugin-vue": "6.2.2",
    "html-webpack-plugin": "3.2.0",
    "mockjs": "1.0.1-beta3",
    "sass": "1.26.8",
    "sass-loader": "8.0.2",
    "script-ext-html-webpack-plugin": "2.1.3",
    "svg-sprite-loader": "4.1.3",
    "svgo": "1.2.2",
    "url-loader": "^4.1.1",
    "vue-seamless-scroll": "^1.1.23",
    "vue-template-compiler": "^2.6.10"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "engines": {
    "node": ">=8.9",
    "npm": ">= 3.0.0"
  },
  "license": "MIT",
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es6": true
    },
    "parserOptions": {
      "parser": "babel-eslint",
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "extends": [
      "plugin:vue/recommended",
      "eslint:recommended"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "vue/max-attributes-per-line": [
        "warn",
        {
          "singleline": 8,
          "multiline": {
            "max": 4
          }
        }
      ],
      "vue/html-self-closing": "off",
      "vue/singleline-html-element-content-newline": "off",
      "vue/multiline-html-element-content-newline": "off",
      "vue/attributes-order": "off",
      "vue/order-in-components": "off",
      "vue/no-v-html": "off"
    }
  }
}
